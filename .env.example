# Guzar Cloud API Configuration (.env.example)
# Copy this file to .env and replace placeholder values before running in production.

# HTTP Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL Database Configuration
POSTGRES_DB=mezon_cloud
POSTGRES_USER=mezon_admin
MEZON_POSTGRES_ADMIN_PASSWORD=change_this_admin_password_in_production
MEZON_APP_DB_PASSWORD=change_this_app_password_in_production

# Cloud API Database Connection (mezon_app role - runtime only, non-superuser, no-bypassrls)
DATABASE_URL=postgres://mezon_app:change_this_app_password_in_production@postgres:5432/mezon_cloud

# Cloud Admin Database Connection (migrations and org:create CLI only)
DATABASE_ADMIN_URL=postgres://mezon_admin:change_this_admin_password_in_production@postgres:5432/mezon_cloud

# Security & Authentication
# JWT Secret MUST be at least 32 characters long
JWT_SECRET=change_this_to_a_cryptographically_secure_random_32_plus_char_secret_key

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=https://admin.guzar.uz,https://market.guzar.uz

# Reverse Proxy (Caddy)
CLOUD_DOMAIN=api.guzar.uz
ACME_EMAIL=admin@guzar.uz
