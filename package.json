{
  "name": "mezon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "node scripts/lint-workspaces.mjs",
    "lint:fix": "node scripts/lint-workspaces.mjs --fix",
    "test:unit": "vitest run --project unit --project sqlite-hub",
    "test:perf": "vitest run --project perf",
    "test": "pnpm run test:unit && pnpm run test:perf",
    "db:check": "turbo run db:check",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps/*/src packages/*/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run format:check && pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run db:check && pnpm run test && pnpm run depcruise"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
