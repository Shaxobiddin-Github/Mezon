<?xml version="1.0" encoding="utf-8"?>
<!-- The paired terminal key is encrypted with a Keystore key that never leaves the phone:
     backing it up or moving it to another device is useless and is disabled. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
