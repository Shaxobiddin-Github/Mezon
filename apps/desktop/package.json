{
  "name": "@mezon/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepare-app": "pnpm --workspace-root run build && node ./scripts/prepare-electron-app.mjs",
    "pack:dir": "pnpm run prepare-app && pnpm exec electron-builder --config ./electron-builder.yml --dir",
    "pack:win": "pnpm run prepare-app && pnpm exec electron-builder --config ./electron-builder.yml --win nsis",
    "verify:fuses": "node ./scripts/verify-packaged-desktop.mjs",
    "verify:abi": "node ./scripts/verify-electron-abi.mjs",
    "test:e2e": "playwright test --config ./playwright.config.mjs"
  },
  "dependencies": {
    "@mezon/contracts": "workspace:*",
    "@mezon/domain": "workspace:*",
    "@mezon/drivers": "workspace:*",
    "koffi": "3.3.7",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "1.65.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.65.0"
  }
}
